{
  "name": "opengym",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint apps/web/src apps/api/src packages/shared/src",
    "typecheck": "pnpm -r run typecheck",
    "test": "node scripts/test-runner.mjs",
    "test:coverage": "node scripts/test-runner.mjs --coverage",
    "test:coverage:workspace": "pnpm --filter @opengym/shared exec vitest run --coverage && pnpm --filter @opengym/api exec vitest run --coverage",
    "build": "pnpm -r run build",
    "test:compose": "node scripts/compose-smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.3.0",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
